{
  "name": "moodletweaks",
  "version": "1.1.0",
  "private": true,
  "description": "Manifest V3 browser extension for EVA",
  "scripts": {
    "pretest": "node scripts/check-tests.mjs",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:firefox": "web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "web-ext": "^10.6.0"
  }
}
